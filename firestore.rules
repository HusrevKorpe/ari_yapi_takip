rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile: only the user themselves can read/write.
    // ONEMLI: organizationId'yi client KENDISI atayamaz/degistiremez; aksi
    // halde herhangi bir kullanici kendi profilinde organizationId'yi baska
    // bir org'un id'siyle degistirip o firmanin tum verisine erisebilir
    // (capraz-kiracil yetki yukseltmesi). organizationId yalnizca Firebase
    // Console / Admin SDK ile atanir.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Kullanici kendi profilini olusturabilir ama organizationId iceremez.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !("organizationId" in request.resource.data);

      // Guncellemede organizationId oldugu gibi korunmali (degistirilemez,
      // sonradan eklenemez).
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (!("organizationId" in request.resource.data)
                        ? !("organizationId" in resource.data)
                        : request.resource.data.organizationId
                            == resource.data.organizationId);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Organization document
    match /organizations/{orgId} {
      // Admin 1: kendi uid'ini orgId olarak kullanarak ilk kez org oluşturur.
      // Bu noktada users/{uid} henüz yazılmamış olabilir, isOrgMember çalışmaz.
      allow create: if request.auth != null && request.auth.uid == orgId;

      // Sonraki okuma/güncelleme/silme: sadece org üyeleri
      allow read, update, delete: if request.auth != null && isOrgMember(orgId);

      // Alt koleksiyonlar (workers, sites, attendance, ...)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && isOrgMember(orgId);
      }
    }

    // Kullanıcının kendi organizasyonuna üye olup olmadığını kontrol et
    function isOrgMember(orgId) {
      // NOT: get() var olmayan dokumanda null doner; Resource'ta `.exists`
      // property'si YOKTUR (varlik kontrolu `!= null` ile yapilir). Onceki
      // `userDoc.exists` ifadesi, kullanici dokumani VAR oldugunda bile
      // "Property exists is undefined" degerlendirme hatasi firlatip her org
      // uyesini reddediyordu — offline-first oldugu icin sessizce fark edilmedi.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data.organizationId == orgId;
    }

    // Diğer her şeyi reddet
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
